            <div class="emoji">🥛</div>
            <h3>ताजा दूध</h3>
            <p class="price">₹50 / लीटर</p>
            <button onclick="addToCart('ताजा दूध',50)">
                🛒 कार्ट में जोड़ें
            </button>
        </div>

        <div class="product" data-name="मिट्टी के बर्तन">
            <div class="emoji">🏺</div>
            <h3>मिट्टी के बर्तन</h3>
            <p class="price">₹200 / सेट</p>
            <button onclick="addToCart('मिट्टी के बर्तन',200)">
                🛒 कार्ट में जोड़ें
            </button>
        </div>

    </div>
</section>

<div class="cart-box" id="cart">
    <h2>🛒 आपका शॉपिंग कार्ट</h2>
    <div id="cartItems">अभी आपका कार्ट खाली है।</div>
    <h3 id="total">कुल राशि: ₹0</h3>
    <button onclick="checkout()">ऑर्डर की जानकारी देखें</button>
</div>

<section id="about">
    <h2>🌱 हमारे बारे में</h2>
    <p style="text-align:center;max-width:750px;margin:auto;line-height:1.8">
        ग्राम बाजार, आकृति यादव द्वारा बनाया गया एक वेबसाइट प्रोजेक्ट है।
        इसका उद्देश्य गाँव के उत्पादों, स्थानीय कारीगरों और किसानों को
        डिजिटल बाजार से जोड़ने का विचार प्रस्तुत करना है।
    </p>
</section>

<section id="contact">
    <h2>📞 संपर्क करें</h2>
    <p style="text-align:center;line-height:2">
        वेबसाइट निर्माता: आकृति यादव<br>
        ईमेल: अपनी ईमेल आईडी यहाँ लिखें
    </p>
</section>

<footer>
    <h2>🏡 ग्राम बाजार</h2>
    <p>गाँव की खुशहाली, सबकी भागीदारी 🌿</p>
    <p>Website Designed by Akriti Yadav</p>
    <p>© 2026 ग्राम बाजार | सभी अधिकार सुरक्षित</p>
</footer>

<script>
let cart = [];

function addToCart(name, price) {
    cart.push({name: name, price: price});
    updateCart();
    alert(name + " कार्ट में जोड़ दिया गया!");
}

function updateCart() {
    document.getElementById("count").textContent = cart.length;

    const items = document.getElementById("cartItems");
    const totalElement = document.getElementById("total");

    if (cart.length === 0) {
        items.textContent = "अभी आपका कार्ट खाली है।";
        totalElement.textContent = "कुल राशि: ₹0";
        return;
    }

    items.innerHTML = cart.map((item, index) =>
        `<p>${item.name} - ₹${item.price}
        <button onclick="removeItem(${index})">हटाएँ</button></p>`
    ).join("");

    const total = cart.reduce((sum, item) => sum + item.price, 0);
    totalElement.textContent = "कुल राशि: ₹" + total;
}

function removeItem(index) {
    cart.splice(index, 1);
    updateCart();
}

function showCart() {
    document.getElementById("cart").scrollIntoView({
        behavior: "smooth"
    });
}

function searchProducts() {
    const query = document.getElementById("search").value.toLowerCase();
    const products = document.querySelectorAll(".product");

    products.forEach(product => {
        const name = product.dataset.name.toLowerCase();
        product.style.display = name.includes(query) ? "" : "none";
    });
}

function checkout() {
    if (cart.length === 0) {
        alert("कृपया पहले कोई उत्पाद कार्ट में जोड़ें।");
        return;
    }

    const total = cart.reduce((sum, item) => sum + item.price, 0);
    const order = cart.map(item => item.name + " - ₹" + item.price).join("\n");

    alert(
        "आपके चुने हुए उत्पाद:\n" + order +
        "\n\nकुल राशि: ₹" + total +
        "\n\nयह एक डेमो वेबसाइट है। वास्तविक ऑर्डर के लिए संपर्क व्यवस्था जोड़नी होगी।"
    );
}
</script>

</body>
